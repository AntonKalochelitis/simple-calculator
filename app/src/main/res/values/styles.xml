<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FontRobotoMonoText">
        <item name="android:fontFamily">@font/robot_mono_medium</item>
    </style>
    <style name="CalcButtonWhite" parent="FontRobotoMonoText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:background">@drawable/button_background_white</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">60sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
